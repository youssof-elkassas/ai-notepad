# ─────────────────────────────────────────────────────────────
#  AI Notepad — Environment Configuration
# ─────────────────────────────────────────────────────────────

# PRIMARY (free): Get your key at https://aistudio.google.com
# No credit card required. 1,500 requests/day free tier.
GOOGLE_API_KEY=your_google_api_key_here

# OPTIONAL FALLBACK: OpenAI (paid, ~$0.01 per run)
# Only used if LLM_PROVIDER=openai
OPENAI_API_KEY=

# VLM provider to use: "gemini" (default, free) or "openai" (paid)
LLM_PROVIDER=gemini

# Gemini model to use (default is free-tier capable)
GEMINI_MODEL=gemini-2.5-flash

# OpenAI model (only used when LLM_PROVIDER=openai)
OPENAI_MODEL=gpt-4o

# Grounding retry attempts before giving up
MAX_GROUNDING_RETRIES=3

# Plain-English target for VLM grounding (default: Notepad desktop shortcut icon)
GROUNDING_QUERY=Notepad desktop shortcut icon

# Visual hints for the VLM (optional; omit to use built-in Notepad description)
# Use \n for line breaks, e.g.:
# GROUNDING_VISUAL_DESCRIPTION=- A small desktop shortcut icon\n- Blue document with lines\n- Label reads "Notepad"

# Check for and dismiss blocking dialogs before grounding (true/false, default: true)
CHECK_POPUPS=true

# Save copies of images sent to the VLM under screenshots/vlm_trace/ (true/false, default: true)
VLM_TRACE=true

# Reuse grounded (x, y) across posts in the same run (true/false, default: true)
COORD_CACHE=true

# Last-resort template matching after VLM grounding fails (true/false, default: true)
TEMPLATE_MATCH_FALLBACK=true

# Path to template image for BotCity matching (default: resources/templates/notepad_shortcut.png)
TEMPLATE_IMAGE_PATH=resources/templates/notepad_shortcut.png

# Minimum match confidence 0.0–1.0 (default: 0.85)
TEMPLATE_MATCHING=0.85

# Seconds to wait after launching Notepad before interacting
NOTEPAD_LAUNCH_WAIT=2.0

# IF I WANT TO TEST GROUNDING ANOTHER ICON I.E: RECYCLE BIN I CAN CHANGE THE GROUNDING_QUERY TO:
# GROUNDING_QUERY=Recycle Bin desktop icon
# AND THE VISUAL DESCRIPTION TO:
# GROUNDING_VISUAL_DESCRIPTION=- A small Windows desktop shortcut icon, approximately 32-48 pixels wide.\n- The Recycle Bin icon shows a wastebasket / trash can, often blue-gray or metallic, sometimes with a recycling symbol.\n- It has a short text label directly underneath it reading "Recycle Bin".\n- It sits on the desktop surface (NOT inside the taskbar at the very bottom).\n- It could be ANYWHERE in the image — do not assume any particular location